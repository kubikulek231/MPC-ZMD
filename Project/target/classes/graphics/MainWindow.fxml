<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="860.0" prefWidth="1120.0" styleClass="app-root" stylesheets="@main-window.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="graphics.MainWindowController">
   <top>
      <VBox>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="hero-bar">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="hero-title" text="JPEG Pipeline Studio" />
                        <Label styleClass="hero-subtitle" text="Experiment with YCbCr conversion, sampling, transform and quantization." wrapText="true" />
                     </children>
                  </VBox>
                  <Pane HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" spacing="8.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#changeImage" styleClass="top-action-button" text="Open Image" />
                        <Button mnemonicParsing="false" onAction="#useDefaultImage" styleClass="top-action-button" text="Load Default Image" />
                        <Button fx:id="btnUndoChanges" mnemonicParsing="false" onAction="#reset" styleClass="top-action-button top-action-warning" text="Undo Changes" disable="true" />
                        <Button mnemonicParsing="false" onAction="#closeWindows" styleClass="top-action-button" text="Close Previews" />
                        <Button mnemonicParsing="false" onAction="#close" styleClass="top-action-button top-action-danger" text="Exit" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="14.0" styleClass="content-wrap">
               <children>
                  <HBox spacing="14.0">
                     <children>
                        <VBox spacing="12.0" styleClass="card">
                           <children>
                              <Label styleClass="card-title" text="Source Channels" />
                              <GridPane hgap="8.0" vgap="8.0">
                                 <children>
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showOriginal" styleClass="primary-button" text="Show Source" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showRedOriginal" styleClass="channel-red" text="Red" GridPane.rowIndex="1" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showGreenOriginal" styleClass="channel-green" text="Green" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showBlueOriginal" styleClass="channel-blue" text="Blue" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showYOriginal" text="Y" GridPane.rowIndex="2" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showCbOriginal" text="Cb" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showCrOriginal" text="Cr" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                 </children>
                              </GridPane>
                              <CheckBox fx:id="shadesOfGrey" mnemonicParsing="false" styleClass="soft-check" text="Gray Preview" />
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>

                        <VBox spacing="12.0" styleClass="card">
                           <children>
                              <Label styleClass="card-title" text="Current Result" />
                              <GridPane hgap="8.0" vgap="8.0">
                                 <children>
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showRGBModified" styleClass="primary-button" text="Show Result" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showRedModified" styleClass="channel-red" text="Red" GridPane.rowIndex="1" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showGreenModified" styleClass="channel-green" text="Green" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showBlueModified" styleClass="channel-blue" text="Blue" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showYModified" text="Y" GridPane.rowIndex="2" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showCbModified" text="Cb" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showCrModified" text="Cr" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                 </children>
                              </GridPane>
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="14.0">
                     <children>
                        <VBox spacing="10.0" styleClass="card workflow-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="card-title" text="Encode In YCbCr" />
                                    <CheckBox fx:id="guidedMode" mnemonicParsing="false" onAction="#onGuidedModeToggle" selected="true" styleClass="soft-check" text="Guided mode" />
                                    <CheckBox fx:id="showSteps" mnemonicParsing="false" styleClass="soft-check" text="Show step previews" />
                                 </children>
                              </HBox>

                              <Text fx:id="workflowStatus" styleClass="status-text" strokeType="OUTSIDE" strokeWidth="0.0" text="Workflow status" wrappingWidth="500.0" />

                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Button fx:id="buttonToYCbCr" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#convertToYCbCr" styleClass="step-button" text="1. Convert RGB to YCbCr" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Button fx:id="buttonSample" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#sample" styleClass="step-button" text="2. Downsample Chroma" />
                                    <ComboBox fx:id="sampling" maxWidth="1.7976931348623157E308" prefWidth="170.0" promptText="Sampling" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Button fx:id="buttonTransform" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#transform" styleClass="step-button" text="3. Apply Transform" />
                                    <ComboBox fx:id="transformType" prefWidth="150.0" promptText="Transform" />
                                    <Spinner fx:id="transformBlock" prefWidth="82.0" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Button fx:id="buttonQuantize" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#quantize" styleClass="step-button" text="4. Quantize Coefficients" />
                                    <Slider fx:id="quantizeQuality" prefWidth="210.0" showTickLabels="true" showTickMarks="true" />
                                    <TextField fx:id="quantizeQualityField" prefWidth="60.0" />
                                 </children>
                              </HBox>
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card workflow-card">
                           <children>
                              <Label styleClass="card-title" text="Return To RGB" />
                              <Button fx:id="buttonInverseQuantize" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#inverseQuantize" styleClass="step-button" text="4. Dequantize Coefficients" />
                              <Button fx:id="buttonInverseTransform" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#inverseTransform" styleClass="step-button" text="3. Inverse Transform" />
                              <Button fx:id="buttonInverseSample" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#inverseSample" styleClass="step-button" text="2. Restore Sampling" />
                              <Button fx:id="buttonInverseToRGB" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#convertToRGB" styleClass="primary-button" text="5. Convert YCbCr to RGB" />
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="12.0" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="RGB Quality Metrics" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Button fx:id="buttonCountPSNR" mnemonicParsing="false" onAction="#countPSNR" styleClass="primary-button metric-action" text="Calculate Metrics" />
                              <GridPane hgap="10.0" vgap="8.0">
                                 <children>
                                    <Label text="MSE" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                       <tooltip>
                                          <Tooltip text="Mean Squared Error. Lower is better. 0 means identical reconstruction." />
                                       </tooltip>
                                    </Label>
                                    <TextField fx:id="qualityMSE" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                       <tooltip>
                                          <Tooltip text="Mean Squared Error. Smaller values indicate less distortion." />
                                       </tooltip>
                                    </TextField>

                                    <Label text="MAE" GridPane.rowIndex="0" GridPane.columnIndex="2">
                                       <tooltip>
                                          <Tooltip text="Mean Absolute Error. Lower is better." />
                                       </tooltip>
                                    </Label>
                                    <TextField fx:id="qualityMAE" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="3">
                                       <tooltip>
                                          <Tooltip text="Mean Absolute Error across all compared values." />
                                       </tooltip>
                                    </TextField>

                                    <Label text="SAE" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                       <tooltip>
                                          <Tooltip text="Sum of Absolute Errors. Lower is better." />
                                       </tooltip>
                                    </Label>
                                    <TextField fx:id="qualitySAE" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                       <tooltip>
                                          <Tooltip text="Total absolute error. Best value is 0." />
                                       </tooltip>
                                    </TextField>

                                    <Label text="PSNR" GridPane.rowIndex="1" GridPane.columnIndex="2">
                                       <tooltip>
                                          <Tooltip text="Peak Signal-to-Noise Ratio in dB. Higher is better." />
                                       </tooltip>
                                    </Label>
                                    <TextField fx:id="qualityPSNR" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="3">
                                       <tooltip>
                                          <Tooltip text="PSNR in dB. Around 40 dB or higher is usually very good." />
                                       </tooltip>
                                    </TextField>
                                 </children>
                              </GridPane>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Separator />
                  <Label styleClass="card-title" text="Watermarking" style="-fx-font-size: 18px;" />
                  <Text fx:id="wmWorkflowStatus" styleClass="workflow-hint" wrappingWidth="700" text="Step 1: Load an image above, then convert to YCbCr. Step 2: Load a watermark image. Step 3: Embed (LSB or DCT). Step 4: Convert back to RGB. Step 5: Apply attacks. Step 6: Convert to YCbCr again, then extract." />

                  <HBox spacing="14.0">
                     <children>
                        <VBox spacing="10.0" styleClass="card">
                           <children>
                              <Label styleClass="card-title" text="Watermark Image" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnLoadWatermark" mnemonicParsing="false" onAction="#loadWatermark" styleClass="primary-button" text="Load Watermark" />
                                    <Label fx:id="wmStatusLabel" text="No watermark loaded" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnShowWatermark" mnemonicParsing="false" onAction="#showWatermark" text="Show Watermark" />
                                    <Button fx:id="btnShowExtracted" mnemonicParsing="false" onAction="#showExtractedWatermark" text="Show Extracted" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <CheckBox fx:id="wmMultiInsert" mnemonicParsing="false" styleClass="soft-check" text="Multi-insert (tile)">
                                       <tooltip><Tooltip text="Tile the watermark across the entire channel for redundancy (majority voting on extract)" /></tooltip>
                                    </CheckBox>
                                 </children>
                              </HBox>
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="14.0">
                     <children>
                        <VBox spacing="10.0" styleClass="card">
                           <children>
                              <Label styleClass="card-title" text="LSB Watermark (Spatial)">
                                 <tooltip><Tooltip wrapText="true" maxWidth="360" text="LSB = Least Significant Bit. Each pixel value (0-255) is stored as 8 bits. Bit 0 (LSB) carries the least visual weight -- flipping it changes the pixel by just 1, which is invisible. Higher bit planes (1, 2, ...) are more robust to attacks but increasingly visible. For a good balance use bit plane 0 or 1." /></tooltip>
                              </Label>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Channel:" />
                                    <ComboBox fx:id="wmLsbChannel" prefWidth="100.0" promptText="Y">
                                       <tooltip><Tooltip text="YCbCr channel to embed the watermark into" /></tooltip>
                                    </ComboBox>
                                    <Label text="Bit plane (h):" />
                                    <Spinner fx:id="wmLsbBitPlane" editable="true" prefWidth="70.0">
                                       <tooltip><Tooltip wrapText="true" maxWidth="340" text="Which bit of each pixel to replace with the watermark bit. 0 = LSB (least visible, least robust), 7 = MSB (very visible, very robust). Recommended: 0 for invisibility, 1 for a bit more robustness while still being hard to notice." /></tooltip>
                                    </Spinner>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Key:" />
                                    <TextField fx:id="wmLsbKey" prefWidth="80.0" text="42">
                                       <tooltip><Tooltip text="Permutation seed for scrambling watermark bits (any integer)" /></tooltip>
                                    </TextField>
                                    <Label text="Strength:" />
                                    <Spinner fx:id="wmLsbStrength" editable="true" prefWidth="80.0">
                                       <tooltip><Tooltip text="Robustness parameter (0–255). Higher = more robust but more visible" /></tooltip>
                                    </Spinner>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnLsbEmbed" mnemonicParsing="false" onAction="#lsbEmbed" styleClass="primary-button" text="Embed LSB" />
                                    <Button fx:id="btnLsbExtract" mnemonicParsing="false" onAction="#lsbExtract" text="Extract LSB" />
                                 </children>
                              </HBox>
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card">
                           <children>
                              <Label styleClass="card-title" text="DCT Watermark (Frequency)">
                                 <tooltip><Tooltip wrapText="true" maxWidth="400" text="Embeds one watermark bit per 8x8 DCT block (as in the JPEG standard) by comparing two chosen mid-frequency coefficients. Pick positions in the mid-frequency band of the 8x8 block -- not too close to (0,0) (visible artifacts) and not too close to (7,7) (fragile to compression). Recommended pairs for 8x8: (3,1)&amp;(4,1), (4,3)&amp;(5,2), (1,4)&amp;(3,3). These sit in the mid-frequencies where changes are hard to see but survive JPEG recompression." /></tooltip>
                              </Label>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Block:" />
                                    <Spinner fx:id="wmDctBlock" prefWidth="70.0">
                                       <tooltip><Tooltip wrapText="true" maxWidth="300" text="DCT block size. Use 8 to match standard JPEG (as required by the assignment). Each 8x8 block carries one watermark bit." /></tooltip>
                                    </Spinner>
                                    <Label text="Coeff 1 (u1,v1):" />
                                    <Spinner fx:id="wmDctU1" editable="true" prefWidth="60.0">
                                       <tooltip><Tooltip wrapText="true" maxWidth="320" text="Row of the 1st DCT coefficient (0-7 for 8x8 blocks). Pick a mid-frequency position -- e.g. row 3 or 4. Avoid row 0 (DC, too visible) and row 7 (high freq, easily destroyed)." /></tooltip>
                                    </Spinner>
                                    <Spinner fx:id="wmDctV1" editable="true" prefWidth="60.0">
                                       <tooltip><Tooltip wrapText="true" maxWidth="320" text="Column of the 1st DCT coefficient (0-7 for 8x8 blocks). Same idea: stay in the middle range (1-5)." /></tooltip>
                                    </Spinner>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Coeff 2 (u2,v2):" />
                                    <Spinner fx:id="wmDctU2" editable="true" prefWidth="60.0">
                                       <tooltip><Tooltip wrapText="true" maxWidth="320" text="Row of the 2nd DCT coefficient. Should be a different mid-frequency position from (u1,v1). The watermark bit is encoded by which of the two coefficients is larger." /></tooltip>
                                    </Spinner>
                                    <Spinner fx:id="wmDctV2" editable="true" prefWidth="60.0">
                                       <tooltip><Tooltip wrapText="true" maxWidth="320" text="Column of the 2nd DCT coefficient. Together with (u2) this is the second position compared against (u1,v1) to encode each bit." /></tooltip>
                                    </Spinner>
                                    <Label text="Depth (h):" />
                                    <TextField fx:id="wmDctDepth" prefWidth="60.0" text="50">
                                       <tooltip><Tooltip text="Robustness depth. Higher = more robust but more distortion" /></tooltip>
                                    </TextField>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnDctEmbed" mnemonicParsing="false" onAction="#dctEmbed" styleClass="primary-button" text="Embed DCT" />
                                    <Button fx:id="btnDctExtract" mnemonicParsing="false" onAction="#dctExtract" text="Extract DCT" />
                                 </children>
                              </HBox>
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="14.0">
                     <children>
                        <VBox spacing="10.0" styleClass="card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="6.0">
                                 <children>
                                    <Label styleClass="card-title" text="Spread Spectrum" />
                                    <Hyperlink onAction="#openSsSource" text="Source" styleClass="card-source-link">
                                       <tooltip><Tooltip text="Cox et al. - Secure Spread Spectrum Watermarking for Multimedia, IEEE 1997" /></tooltip>
                                    </Hyperlink>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Alpha:" />
                                    <TextField fx:id="wmSsAlpha" prefWidth="60.0" text="15">
                                       <tooltip><Tooltip wrapText="true" maxWidth="300" text="Embedding strength. Higher = more robust but more visible. Try 5-30." /></tooltip>
                                    </TextField>
                                    <Label text="Key:" />
                                    <TextField fx:id="wmSsKey" prefWidth="80.0" text="42">
                                       <tooltip><Tooltip text="Seed for the pseudo-random noise sequence." /></tooltip>
                                    </TextField>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnSsEmbed" mnemonicParsing="false" onAction="#ssEmbed" styleClass="primary-button" text="Embed SS" />
                                    <Button fx:id="btnSsExtract" mnemonicParsing="false" onAction="#ssExtract" text="Extract SS" />
                                 </children>
                              </HBox>
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="6.0">
                                 <children>
                                    <Label styleClass="card-title" text="Patchwork" />
                                    <Hyperlink onAction="#openPwSource" text="Source" styleClass="card-source-link">
                                       <tooltip><Tooltip text="Bender et al. - Techniques for Data Hiding, IBM Systems Journal 1996" /></tooltip>
                                    </Hyperlink>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Delta:" />
                                    <TextField fx:id="wmPwDelta" prefWidth="60.0" text="10">
                                       <tooltip><Tooltip wrapText="true" maxWidth="300" text="Brightness shift applied to each patch. Higher = more robust but more visible. Try 3-20." /></tooltip>
                                    </TextField>
                                    <Label text="Key:" />
                                    <TextField fx:id="wmPwKey" prefWidth="80.0" text="42">
                                       <tooltip><Tooltip text="Seed for picking the random pixel patches." /></tooltip>
                                    </TextField>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnPwEmbed" mnemonicParsing="false" onAction="#pwEmbed" styleClass="primary-button" text="Embed PW" />
                                    <Button fx:id="btnPwExtract" mnemonicParsing="false" onAction="#pwExtract" text="Extract PW" />
                                 </children>
                              </HBox>
                           </children>
                           <HBox.hgrow>
                              <Priority fx:constant="ALWAYS" />
                           </HBox.hgrow>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="10.0" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Attacks on Watermarked Image">
                           <tooltip><Tooltip wrapText="true" maxWidth="400" text="Test watermark robustness by degrading the image. The attacked image replaces the working image so you can try extracting the watermark from it." /></tooltip>
                        </Label>
                        <Text styleClass="workflow-hint" wrappingWidth="650" text="Embed a watermark, convert back to RGB, then click an attack. The attacked image becomes the working image. It can be converted to YCbCr again and extracted to see if the watermark survived." />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Button fx:id="btnAttackJpeg" mnemonicParsing="false" onAction="#attackJpeg" text="JPEG Compress" />
                              <Label text="Quality:" />
                              <TextField fx:id="attackJpegQuality" prefWidth="50.0" text="50">
                                 <tooltip><Tooltip text="JPEG compression quality (1 = worst, 100 = best/original)" /></tooltip>
                              </TextField>
                              <Button fx:id="btnAttackPng" mnemonicParsing="false" onAction="#attackPng" text="PNG Compress" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Button fx:id="btnAttackRotate45" mnemonicParsing="false" onAction="#attackRotate45" text="Rotate 45&#xB0;" />
                              <Button fx:id="btnAttackRotate90" mnemonicParsing="false" onAction="#attackRotate90" text="Rotate 90&#xB0;" />
                              <Button fx:id="btnAttackResize75" mnemonicParsing="false" onAction="#attackResize75" text="Resize 75%" />
                              <Button fx:id="btnAttackResize50" mnemonicParsing="false" onAction="#attackResize50" text="Resize 50%" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Button fx:id="btnAttackMirror" mnemonicParsing="false" onAction="#attackMirror" text="Mirror" />
                              <Button fx:id="btnAttackCrop" mnemonicParsing="false" onAction="#attackCrop" text="Crop 10%" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Separator />
                  <VBox spacing="10.0" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Automated Report Export" />
                        <Text styleClass="workflow-hint" wrappingWidth="650" text="Export All: runs all predefined scenarios (4 methods x 3 configs x 13 attacks) using default images. Export Custom: runs the selected method with current UI params against the chosen attack (or all attacks)." />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#exportAllXlsx" styleClass="primary-button" text="Export All Scenarios" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label text="Method:" />
                              <ComboBox fx:id="exportMethod" prefWidth="160.0" />
                              <Label text="Attack:" />
                              <ComboBox fx:id="exportAttack" prefWidth="160.0" />
                              <Button mnemonicParsing="false" onAction="#runExport" text="Run Pipeline" />
                              <Button mnemonicParsing="false" onAction="#exportCustomXlsx" text="Export Custom" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
